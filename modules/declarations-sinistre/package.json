{
  "name": "gam-declarations-sinistre-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Face client (PWA) de la déclaration de sinistre GAM — offline-first.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:tunnel": "cloudflared tunnel --url http://localhost:5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2"
  }
}
