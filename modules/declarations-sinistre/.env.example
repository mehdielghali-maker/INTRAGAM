# Configuration de la PWA client « Déclaration de sinistre ».
# Copier en .env.local et ajuster. Aucune valeur sensible n'est commitée.

# Mode de l'adaptateur : mock (dev, par défaut) ou real (backend DECSIN).
VITE_DECSIN_MODE=mock

# Backend DECSIN (utilisé seulement en mode real).
VITE_DECSIN_BASE_URL=https://api2.gam.dz/DECSIN/api/
# [DSI à confirmer] nom + valeur de l'en-tête de clé d'API.
VITE_DECSIN_API_KEY=
VITE_DECSIN_API_KEY_HEADER=X-Api-Key

# Session terrain (jours) — durée de validité de la session client hors-ligne.
VITE_SESSION_TERRAIN_JOURS=7

# Préfixe du code de déclaration (format DEC-XXXX-AAAA).
VITE_CODE_PREFIXE=DEC

# Reconnaissance véhicule + lecture de plaque (service RECO INDÉPENDANT, appelé directement).
# mock (dev, par défaut, hors-ligne) ou real (microservice RECO via VITE_RECO_BASE_URL).
VITE_RECO_MODE=mock
# URL du microservice RECO (FastAPI). En real, le service doit autoriser le CORS de cette origine.
VITE_RECO_BASE_URL=http://localhost:8088
