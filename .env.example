# ===== Stack complète INTRAGAM (Étage 2) — docker-compose.full.yml =====
# Copier en .env (déjà ignoré par git) et ajuster. AUCUN secret par défaut : la démo tourne en mock.

# --- Front (poste AGA) — variables AU BUILD (Vite les inline) ---
VITE_API_MODE=real            # le poste appelle le backend Spring via le proxy nginx (/api)
VITE_API_BASE_URL=            # vide = même origine (nginx). Renseigner SI le front est sur une autre origine.
VITE_DECSIN_MODE=mock         # déclaration en mock (DECSIN externe non requis pour la démo)
VITE_SOUSCRIPTION_MODE=mock   # souscription en mock (GAM/SecGam non requis pour la démo)
FRONT_PORT=8081               # port local exposé pour le poste (http://localhost:8081)

# --- Backend Spring ---
SPRING_PROFILES_ACTIVE=
RECO_MODE=http                # le backend appelle le microservice RECO en HTTP
RECO_BLOQUE_NON_CONFORME=false
# CORS : origines autorisées (séparées par virgules) SI le front est hébergé sur une AUTRE origine.
# Vide = même origine (proxy nginx) → pas de CORS. Ex : CORS_ALLOWED_ORIGINS=https://poste.mondomaine.dz
CORS_ALLOWED_ORIGINS=

# --- DECSIN / GAM (appelés par le FRONT, pas par le backend Java dans ce dépôt) ---
# En mode real, ces backends externes (DECSIN, /SecGam) sont appelés CÔTÉ FRONT (@decsin/@souscription) :
# configurer alors VITE_DECSIN_BASE_URL / VITE_SOUSCRIPTION_BASE_URL + clés d'API côté front.
# Les clés sont des SECRETS → variables d'environnement de la plateforme, JAMAIS commitées.
# DECSIN_API_KEY=__A_CONFIRMER__

# --- Infra (PostgreSQL / RabbitMQ) ---
POSTGRES_DB=poste
POSTGRES_USER=poste
POSTGRES_PASSWORD=poste
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- RECO (seuils du microservice) ---
RECO_SEUIL_VEHICULE=0.45
RECO_SEUIL_PLAQUE=0.35

# --- OCR-DOC (attestations — même service que RECO, endpoint /lire-attestation) ---
OCR_MODE=http                 # le backend appelle l'OCR document en HTTP (mock sinon)
OCR_DOC_ACTIF=true            # false = service RECO seul (PaddleOCR non chargé, ~2 Go économisés)
OCR_LANGS=fr,arabic           # attestation bilingue (libellé arabe du n° de police)
OCR_SEUIL_CONFIANCE=0.60
