# Configuration de la PWA agent « Souscription auto ». Copier en .env.local et ajuster.

# Bascule GLOBALE des adaptateurs : mock (défaut) | real. Repli si les VITE_*_MODE par domaine
# ne sont pas définis. Hébergement statique de TEST (Étage 1) : laisser « mock » (aucun appel réseau).
VITE_API_MODE=mock
# (optionnel, mode real) URL d'un back-end ; voir aussi les base-url par domaine ci-dessous.
# VITE_API_BASE_URL=

# Mode de l'adaptateur SOUSCRIPTION : mock (dev, par défaut) ou real (backend GAM /SecGam). Prioritaire sur VITE_API_MODE.
VITE_SOUSCRIPTION_MODE=mock

# Backend GAM (mode real). [DSI à confirmer] base + nom/valeur de la clé d'API.
VITE_SOUSCRIPTION_BASE_URL=https://api2.gam.dz/APIS/api/v2/
VITE_SOUSCRIPTION_API_KEY=
VITE_SOUSCRIPTION_API_KEY_HEADER=X-Api-Key

# Session agent (jours) — durée de validité de la session locale hors-ligne.
VITE_SESSION_AGENT_JOURS=7

# Préfixe de la référence de souscription (format SCR-XXXX-AAAA).
VITE_CODE_PREFIXE=SCR
