# Variables d'environnement du poste (frontend). Copier en .env.local et ajuster.

# Déclaration de sinistre — adaptateur DECSIN (mock en dev, real pour le backend).
VITE_DECSIN_MODE=mock
VITE_DECSIN_BASE_URL=https://api2.gam.dz/DECSIN/api/
# [DSI à confirmer] nom + valeur de l'en-tête de clé d'API.
VITE_DECSIN_API_KEY=
VITE_DECSIN_API_KEY_HEADER=X-Api-Key
# Préfixe du code de déclaration (format DEC-XXXX-AAAA).
VITE_CODE_PREFIXE=DEC

# URL de la PWA client (lien envoyé au client par l'AGA).
VITE_CLIENT_URL=http://localhost:5174

# Souscription auto — adaptateur GAM (/SecGam) mock↔réel.
VITE_SOUSCRIPTION_MODE=mock
VITE_SOUSCRIPTION_BASE_URL=https://api2.gam.dz/APIS/api/v2/
VITE_SOUSCRIPTION_API_KEY=
VITE_SOUSCRIPTION_API_KEY_HEADER=X-Api-Key
# Préfixe de la référence de souscription (format SCR-XXXX-AAAA).
# (VITE_CODE_PREFIXE est partagé ; mettre SCR si le poste ne sert que la souscription.)
